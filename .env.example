# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bookkeeping
DB_USERNAME=root
DB_PASSWORD=your-secure-password

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 微信小程序配置
WX_APP_ID=your-miniapp-appid
WX_APP_SECRET=your-miniapp-secret

# 微信公众号配置
WECHAT_APP_ID=your-wechat-appid
WECHAT_APP_SECRET=your-wechat-secret
WECHAT_TEMPLATE_ID=your-template-id

# JWT配置
JWT_SECRET=your-256-bit-secret-key-here-must-be-at-least-256-bits-long-for-security
JWT_EXPIRATION=86400000

# 管理员初始化配置（仅首次启动时使用）
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=your-secure-admin-password
